# 
# Game Dev OS — environment variable reference
#
# Every setting below is OPTIONAL. The app runs with no configuration at all;
# the values shown are the defaults used when a variable is not set.
#
# The app does NOT load this file automatically. Set the variables you need in
# your shell before starting it, or in your host's dashboard (e.g. Render):
#   PowerShell:  $env:GAME_DEV_OS_PORT = "8000"; python app.py
#   bash/zsh:    GAME_DEV_OS_PORT=8000 python app.py
#
# If you copy this to a file named .env, never commit it — it may hold API keys
# (.env is listed in .gitignore).



# SERVER

# Address the web server binds to. 0.0.0.0 = reachable from other machines on
# your network; 127.0.0.1 = this machine only.
# Default: 0.0.0.0 (python app.py) / 127.0.0.1 (run_server.py, backend_entry.py)
GAME_DEV_OS_HOST=0.0.0.0

# Port for the web server. PORT takes priority (set automatically by Render).
# Default: 5000 (python app.py) / 5137 (run_server.py, backend_entry.py)
PORT=
GAME_DEV_OS_PORT=5000

# Flask debug mode. Use 1/true/yes to enable. Keep off in production.
GAME_DEV_OS_DEBUG=0


# STORAGE LOCATIONS

# Where uploads, outputs, storage/ and data/ live.
# Default: the project folder (backend_entry.py uses ~/GameDevOS instead)
GAME_DEV_OS_DATA_DIR=

# Where templates/ and static/ are read from. Rarely needs changing.
# Default: the project folder
GAME_DEV_OS_RESOURCE_DIR=

# Set to 1 when running inside the Electron desktop shell.
GAME_DEV_OS_ELECTRON=0


# UNITY EXPORT PATHS
# Point UNITY_PROJECT_DIR at your Unity project root to export straight into it.

# Default: <data dir>/exports/unity
UNITY_PROJECT_DIR=

# Default: <UNITY_PROJECT_DIR>/Assets/Animations/Frames
UNITY_FRAMES_DIR=

# Default: <UNITY_PROJECT_DIR>/Assets/Audio
UNITY_AUDIO_DIR=

# Default: <UNITY_PROJECT_DIR>/Assets/Scenes
UNITY_SCENES_DIR=

# Destination for sliced voice takes from the Voice Take Slicer.
# Default: <data dir>/exports/unity/Assets/Audio/Voice
UNITY_PROJECT_AUDIO_DIR=

# Folder inside exported Unity packages (zip) that assets are placed under.
# Default: Assets/GameAssets
UNITY_EXPORT_SUBDIR=Assets/GameAssets


# AI DIALOGUE ASSISTANT

# Display name of the dialogue / lore assistant.
COMPANION_NAME=Companion

# Ollama model to use. NYX_MODEL is an older name for the same setting.
# Default: llama3.2:1b
COMPANION_MODEL=llama3.2:1b

# Ollama generate endpoint. Note: currently only used by services/nyxaris_svc.py;
# app.py and routing.py still call http://localhost:11434 directly.
OLLAMA_URL=http://localhost:11434/api/generate

# Google Gemini key. When set, Gemini is tried first, before Ollama.
# GOOGLE_API_KEY is accepted as an alternative name.
GEMINI_API_KEY=
GOOGLE_API_KEY=


# AI ANIMATION PROVIDERS
# Each provider is enabled in Animation Studio when its key is set.

# fal.ai (FAL_API_KEY is accepted as an alternative name)
FAL_KEY=
FAL_API_KEY=

# Replicate
REPLICATE_API_TOKEN=

# OpenAI
OPENAI_API_KEY=
